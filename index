const rowsEl = document.getElementById('lib-rows');
function render(filter){
  rowsEl.innerHTML = automations
    .filter(a => filter === 'all' || a.cat === filter)
    .map(a => `
      <div class="lib-row">
        <div class="lib-id">${a.id}</div>
        <div class="lib-name">${a.name}<small>${a.sub}</small></div>
        <div class="lib-cat">${a.cat}</div>
        <div class="lib-tools">${a.tools}</div>
        <div><span class="status-pill ${a.status}">${a.status === 'active' ? 'Active' : 'Inactive'}</span></div>
      </div>
    `).join('');
}
render('all');

document.querySelectorAll('.filter-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    render(btn.dataset.filter);
  });
});

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Operations & Automation Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16233F;
    --ink-soft:#1E3358;
    --paper:#FBF6F3;
    --paper-dim:#F3E7E3;
    --brass:#E8998D;
    --brass-light:#F4BDB0;
    --sage:#D98B7D;
    --rust:#C97364;
    --slate:#5C6B84;
    --line:rgba(22,35,63,0.12);
    --line-light:rgba(251,246,243,0.16);
    font-size:16px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans',sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  h1,h2,h3,h4{font-family:'Space Grotesk',sans-serif;letter-spacing:-0.01em;}
  a{color:inherit;text-decoration:none;}

  .wrap{max-width:1120px;margin:0 auto;padding:0 32px;}

  /* blueprint grid backdrop */
  .blueprint{
    position:relative;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:40px 40px;
  }
  .blueprint-dark{
    background-color:var(--ink);
    background-image:
      linear-gradient(var(--line-light) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-light) 1px, transparent 1px);
    background-size:40px 40px;
  }

  /* ---------- NAV ---------- */
  nav{
    position:sticky;top:0;z-index:50;
    background:rgba(22,35,63,0.96);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;}
  .brand{color:var(--paper);font-weight:600;font-size:17px;display:flex;align-items:center;gap:10px;}
  .brand-mark{
    width:10px;height:10px;background:var(--brass);
    box-shadow:0 0 0 3px rgba(232,153,141,0.25);
  }
  .navlinks{display:flex;gap:28px;}
  .navlinks a{color:rgba(246,244,239,0.7);font-size:14px;font-weight:500;transition:color .2s;}
  .navlinks a:hover{color:var(--brass-light);}
  .navlinks a.cta-link{
    color:var(--ink);background:var(--brass-light);
    padding:8px 16px;border-radius:2px;
  }
  .navlinks a.cta-link:hover{background:var(--brass);color:var(--paper);}

  /* ---------- HERO ---------- */
  .hero{
    background-color:var(--ink);
    color:var(--paper);
    padding:88px 0 80px;
    position:relative;
    overflow:hidden;
  }
  .hero .wrap{position:relative;z-index:2;}
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;
    color:var(--brass-light);
    font-size:12.5px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    display:flex;align-items:center;gap:10px;
    margin-bottom:22px;
  }
  .eyebrow::before{content:"";width:24px;height:1px;background:var(--brass-light);}
  .hero h1{
    font-size:clamp(34px,5vw,54px);
    font-weight:600;
    line-height:1.08;
    max-width:760px;
    color:var(--paper);
  }
  .hero h1 span{color:var(--brass-light);}
  .hero p.lede{
    margin-top:22px;
    font-size:18px;
    color:rgba(246,244,239,0.72);
    max-width:560px;
    line-height:1.65;
  }
  .hero-actions{margin-top:34px;display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    display:inline-block;
    padding:13px 26px;
    font-size:14.5px;
    font-weight:600;
    border-radius:2px;
    cursor:pointer;
    transition:transform .15s, background .2s, color .2s;
  }
  .btn-primary{background:var(--brass);color:var(--ink);}
  .btn-primary:hover{background:var(--brass-light);transform:translateY(-1px);}
  .btn-ghost{border:1px solid rgba(246,244,239,0.28);color:var(--paper);}
  .btn-ghost:hover{border-color:var(--brass-light);color:var(--brass-light);}

  .hero-stats{
    display:flex;gap:44px;
    margin-top:56px;
    padding-top:28px;
    border-top:1px solid rgba(246,244,239,0.14);
    flex-wrap:wrap;
  }
  .stat .num{
    font-family:'IBM Plex Mono',monospace;
    font-size:30px;font-weight:600;color:var(--brass-light);
  }
  .stat .label{font-size:12.5px;color:rgba(246,244,239,0.6);margin-top:4px;text-transform:uppercase;letter-spacing:0.06em;}

  /* signature flow diagram */
  .flow-panel{
    margin-top:64px;
    background:rgba(246,244,239,0.04);
    border:1px solid rgba(246,244,239,0.14);
    border-radius:4px;
    padding:28px 30px 24px;
  }
  .flow-panel-head{
    display:flex;justify-content:space-between;align-items:baseline;
    margin-bottom:22px;flex-wrap:wrap;gap:10px;
  }
  .flow-panel-head .id{font-family:'IBM Plex Mono',monospace;color:var(--brass-light);font-size:12px;letter-spacing:0.08em;}
  .flow-panel-head h3{color:var(--paper);font-size:16px;font-weight:500;}
  .flow-track{
    display:flex;align-items:center;
    overflow-x:auto;
    padding-bottom:6px;
  }
  .fnode{
    flex:0 0 auto;
    min-width:118px;
    text-align:center;
    padding:14px 10px;
    background:rgba(246,244,239,0.06);
    border:1px solid rgba(246,244,239,0.18);
    border-radius:3px;
  }
  .fnode .k{font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--sage);text-transform:uppercase;letter-spacing:.08em;display:block;margin-bottom:6px;}
  .fnode .v{font-size:13px;color:var(--paper);font-weight:500;}
  .fconn{
    flex:0 0 auto;width:42px;height:2px;position:relative;
    background:linear-gradient(90deg, rgba(232,153,141,0.15), rgba(232,153,141,0.7), rgba(232,153,141,0.15));
  }
  .fconn::after{
    content:"";position:absolute;top:-2px;left:0;
    width:6px;height:6px;border-radius:50%;background:var(--brass-light);
    animation:travel 2.6s linear infinite;
  }
  @keyframes travel{
    0%{left:0; opacity:0;}
    10%{opacity:1;}
    90%{opacity:1;}
    100%{left:calc(100% - 6px); opacity:0;}
  }
  .flow-result{
    margin-top:20px;padding-top:18px;
    border-top:1px dashed rgba(246,244,239,0.16);
    display:flex;gap:28px;flex-wrap:wrap;
    font-size:13.5px;color:rgba(246,244,239,0.75);
  }
  .flow-result b{color:var(--brass-light);font-family:'IBM Plex Mono',monospace;font-weight:500;}

  /* ---------- SECTION SHELL ---------- */
  section{padding:84px 0;}
  .section-head{margin-bottom:48px;max-width:640px;}
  .section-tag{
    font-family:'IBM Plex Mono',monospace;font-size:12px;
    color:var(--brass);letter-spacing:0.14em;text-transform:uppercase;
    display:flex;align-items:center;gap:10px;margin-bottom:14px;
  }
  .section-tag::before{content:"";width:24px;height:1px;background:var(--brass);}
  .section-head h2{font-size:32px;font-weight:600;color:var(--ink);}
  .section-head p{margin-top:12px;color:var(--slate);font-size:15.5px;line-height:1.65;}

  /* ---------- EXPERTISE ---------- */
  .expertise-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    background:var(--line);border:1px solid var(--line);
  }
  .expertise-card{
    background:var(--paper);padding:30px 26px;
  }
  .expertise-card .idx{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--brass);margin-bottom:14px;}
  .expertise-card h4{font-size:16.5px;font-weight:600;margin-bottom:8px;}
  .expertise-card p{font-size:13.8px;color:var(--slate);line-height:1.55;}

  /* ---------- AUTOMATION LIBRARY ---------- */
  .lib-filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px;}
  .filter-btn{
    font-family:'IBM Plex Mono',monospace;
    font-size:12.5px;padding:8px 16px;
    border:1px solid var(--line);border-radius:20px;
    background:transparent;color:var(--slate);cursor:pointer;
    transition:all .15s;
  }
  .filter-btn:hover{border-color:var(--brass);color:var(--ink);}
  .filter-btn.active{background:var(--ink);color:var(--paper);border-color:var(--ink);}

  .lib-table{border-top:1px solid var(--line);}
  .lib-row{
    display:grid;
    grid-template-columns:56px 1.4fr 1fr 1fr 100px;
    gap:20px;
    padding:18px 0;
    border-bottom:1px solid var(--line);
    align-items:center;
    transition:background .15s;
  }
  .lib-row:hover{background:var(--paper-dim);}
  .lib-row.head{
    font-family:'IBM Plex Mono',monospace;font-size:11px;text-transform:uppercase;
    letter-spacing:0.06em;color:var(--slate);border-bottom:1px solid var(--ink);
    padding-bottom:12px;
  }
  .lib-id{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--brass);}
  .lib-name{font-weight:600;font-size:14.5px;}
  .lib-name small{display:block;font-weight:400;color:var(--slate);font-size:12.5px;margin-top:2px;}
  .lib-cat{font-size:13px;color:var(--slate);}
  .lib-tools{font-size:12.5px;color:var(--slate);font-family:'IBM Plex Mono',monospace;}
  .status-pill{
    font-family:'IBM Plex Mono',monospace;font-size:11px;
    padding:4px 10px;border-radius:20px;display:inline-flex;align-items:center;gap:6px;
    width:fit-content;
  }
  .status-pill.active{background:rgba(90,138,110,0.14);color:#4C8567;}
  .status-pill.inactive{background:rgba(201,115,100,0.12);color:var(--rust);}
  .status-pill::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;}

  /* ---------- IMPACT ---------- */
  .impact-band{background:var(--ink);color:var(--paper);}
  .impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(246,244,239,0.1);border:1px solid rgba(246,244,239,0.1);}
  .impact-cell{background:var(--ink);padding:34px 28px;}
  .impact-cell .big{font-family:'IBM Plex Mono',monospace;font-size:34px;font-weight:600;color:var(--brass-light);}
  .impact-cell .desc{margin-top:8px;font-size:13.5px;color:rgba(246,244,239,0.65);line-height:1.5;}

  /* ---------- STACK ---------- */
  .stack-row{display:flex;flex-wrap:wrap;gap:12px;}
  .stack-pill{
    display:flex;align-items:center;gap:10px;
    padding:12px 18px;border:1px solid var(--line);border-radius:3px;
    font-size:14px;font-weight:500;background:var(--paper);
  }
  .stack-dot{width:8px;height:8px;background:var(--brass);border-radius:50%;}

  /* ---------- CONTACT ---------- */
  .contact{
    background:var(--ink);color:var(--paper);
    padding:96px 0;
    text-align:center;
  }
  .contact h2{font-size:clamp(28px,4vw,42px);max-width:680px;margin:0 auto;line-height:1.2;}
  .contact h2 span{color:var(--brass-light);}
  .contact p{margin-top:18px;color:rgba(246,244,239,0.65);font-size:15.5px;max-width:520px;margin-left:auto;margin-right:auto;}
  .contact-actions{margin-top:34px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
  .contact-note{
    margin-top:36px;font-family:'IBM Plex Mono',monospace;font-size:12.5px;
    color:rgba(246,244,239,0.4);
  }

  footer{padding:28px 0;text-align:center;color:var(--slate);font-size:12.5px;}

  @media (max-width:820px){
    .expertise-grid{grid-template-columns:1fr;}
    .impact-grid{grid-template-columns:1fr 1fr;}
    .lib-row{grid-template-columns:1fr;gap:6px;padding:16px 0;}
    .lib-row.head{display:none;}
    .lib-id{order:-1;}
    .navlinks a:not(.cta-link){display:none;}
    .hero-stats{gap:28px;}
  }
</style>
</head>
